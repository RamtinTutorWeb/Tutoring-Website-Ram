# TutorPro backend. Copy to backend/.env for local dev (`npm run dev -w backend` loads it).
# On Railway set these as service variables. Never commit real values.

# Railway injects PORT; locally defaults to 4000.
PORT=4000

# Comma-separated allowed CORS origins. The first is used for links in emails
# (e.g. /book?request=<id>). Any http://localhost:* is also allowed outside production.
# Prod: https://<your-vercel-domain>[,https://www.<domain>]
FRONTEND_URL=http://localhost:5173

# Clerk dashboard > Configure > API keys (same app as the frontend's VITE_CLERK_PUBLISHABLE_KEY).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard > Configure > Webhooks > endpoint ${PUBLIC_API_URL}/webhooks/clerk
# (events user.created, user.updated, user.deleted) > Signing Secret (whsec_...).
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase dashboard > Project Settings > API: Project URL and the service_role
# (secret) key. Local: `supabase start`, URL http://127.0.0.1:54321.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend dashboard > API Keys. MAIL_FROM must use a domain verified in Resend,
# e.g. TutorPro <hello@yourdomain.com>. Unset = emails are logged and skipped.
RESEND_API_KEY=
MAIL_FROM=
# Tutor inbox that receives new-request notifications.
ADMIN_EMAIL=

# Calendly > Integrations > API & Webhooks > Personal access token.
# Only needed once, for POST /admin/calendly/register-webhook.
CALENDLY_PERSONAL_ACCESS_TOKEN=
# You choose this: `openssl rand -hex 32`. Sent to Calendly on registration and
# used to verify POST /webhooks/calendly. Unset = Calendly webhooks are refused.
CALENDLY_WEBHOOK_SIGNING_KEY=

# Public origin of this backend (Railway domain), no trailing slash.
# Used to build the Calendly callback URL ${PUBLIC_API_URL}/webhooks/calendly.
PUBLIC_API_URL=http://localhost:4000

# You choose this: `openssl rand -hex 32`. Sent as `x-admin-token` to /admin/calendly/*.
ADMIN_API_TOKEN=
