{
  "name": "tutorpro-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm --workspace frontend run build",
    "preview": "npm --workspace frontend run preview",
    "typecheck:api": "tsc --noEmit -p api",
    "dev:vercel": "vercel dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "mongodb": "^7.2.0",
    "svix": "^2.3.0"
  },
  "devDependencies": {
    "@vercel/node": "^12.0.0",
    "typescript": "^5.9.3"
  }
}
