# Copy to frontend/.env (git-ignored). All values are optional: with none set
# the app runs in legacy mode exactly as before (JWT auth + Express backend).

# Clerk publishable key (pk_test_... / pk_live_...). Enables Clerk auth mode.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project URL and anon (public) key from Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx.xxxxx

# Calendly scheduling link shown on /book.
VITE_CALENDLY_URL=https://calendly.com/your-handle/tutoring-session

# Legacy Express backend base URL. Still used until the Supabase cutover.
VITE_BACKEND_URL=http://localhost:4000
