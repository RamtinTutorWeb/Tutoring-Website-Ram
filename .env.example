# =============================================================================
# TutorPro server environment (Vercel Project -> Settings -> Environment Variables)
# =============================================================================
# These are read by the serverless functions in api/. They are NEVER shipped to
# the browser. Copy to `.env.local` for `vercel dev` (git-ignored) or paste each
# one into the Vercel project settings for Production + Preview.
#
# Frontend variables (prefixed VITE_) live in frontend/.env.example and are
# baked into the Vite bundle at build time. Vercel needs those too, because
# `npm run build` runs on Vercel. Do NOT put secrets in VITE_ variables.
#
#   Server (this file)                 -> Vercel env, used by api/**
#   VITE_CLERK_PUBLISHABLE_KEY         -> frontend/.env.example (public)
#   VITE_SUPABASE_URL                  -> frontend/.env.example (public)
#   VITE_SUPABASE_ANON_KEY             -> frontend/.env.example (public)
#   VITE_CALENDLY_URL                  -> frontend/.env.example (public)
# -----------------------------------------------------------------------------

# --- Clerk (Dashboard -> Configure -> API keys) ------------------------------
# Secret key: sk_test_... / sk_live_... Used for server-side Clerk calls.
CLERK_SECRET_KEY=
# Signing secret of the webhook endpoint https://<domain>/api/clerk/webhook
# (Dashboard -> Configure -> Webhooks -> endpoint -> Signing Secret). whsec_...
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Supabase (Project -> Settings -> API / Data API) ------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co (same value as VITE_SUPABASE_URL)
SUPABASE_URL=
# Service role key. Bypasses row-level security. Server only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Calendly (Integrations -> API & Webhooks) -------------------------------
# Webhook signing key shown when the webhook subscription is created
# (or the key you choose and pass to register-webhook).
CALENDLY_WEBHOOK_SIGNING_KEY=
# Personal access token. Optional: only needed by POST /api/calendly/register-webhook.
CALENDLY_PERSONAL_ACCESS_TOKEN=

# --- Deployment / admin ------------------------------------------------------
# Public origin of the deployment, no trailing slash. Used to build the
# Calendly webhook callback URL.
PUBLIC_BASE_URL=https://your-domain.example
# Random secret required in the `x-admin-token` header for admin-only
# maintenance endpoints (currently /api/calendly/register-webhook).
# Generate: openssl rand -hex 32
ADMIN_API_TOKEN=
