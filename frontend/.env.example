# Copy to frontend/.env (git-ignored). Public values, baked in at build time.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_URL=http://localhost:4000
VITE_CALENDLY_URL=https://calendly.com/your-handle/tutoring-session
# Optional: Cloudflare Turnstile site key (bot check on the contact form; backend needs TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=
# Public origin, e.g. https://tutorpro.com: absolute link-preview image URL, robots.txt sitemap line, sitemap.xml.
VITE_SITE_URL=
# LOCAL DEV ONLY (vite dev server): dev sign-in screen instead of Clerk. Leave VITE_CLERK_PUBLISHABLE_KEY empty.
VITE_DEV_AUTH=
